# Voice Detection UI Environment Variables
# Copy this file to .env and fill in your values

# UI Settings
GRADIO_PORT=7860
GRADIO_HOST=127.0.0.1
INTERFACE_LANGUAGE=en

# Model Paths (optional - defaults to auto-download from HuggingFace)
# MODEL_PATH_AGE_GENDER=/path/to/age-gender-model
# MODEL_PATH_EMOTION=/path/to/emotion-model
# MODEL_PATH_SPEAKER=/path/to/speaker-model

# Performance Settings
MAX_AUDIO_LENGTH=300
BATCH_SIZE=1
NUM_WORKERS=2
